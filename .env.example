# Public site
NEXT_PUBLIC_SITE_URL=https://memorieswithmike.com
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
ENABLE_SAMPLE_CHECKOUT=false
REQUIRE_PRODUCTION_CONFIGURATION=false

# Administrator authentication (comma-separated, exact email match)
ADMIN_EMAIL_ALLOWLIST=michael.kennedy@ku.edu
ADMIN_BOOTSTRAP_EMAIL=michael.kennedy@ku.edu
ADMIN_NOTIFICATION_EMAIL=michael.kennedy@ku.edu
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://replace-me.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace_with_access_application_audience_tag

# Payments
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SHIPPING_RATE_IDS=

# Transactional email
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Memories with Mike <orders@memorieswithmike.com>

# Abuse prevention
RATE_LIMIT_SALT=replace_with_a_long_random_value

# Cloudflare storage uses the DB and BUCKET bindings in wrangler.json.
# Optional S3-compatible portability values:
STORAGE_DRIVER=cloudflare-r2
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Fulfillment
FULFILLMENT_PROVIDER=MANUAL
ORDER_DESK_STORE_ID=
ORDER_DESK_API_KEY=
ORDER_DESK_ENDPOINT=
BAY_PHOTO_ACCOUNT_ID=
BAY_PHOTO_API_KEY=
BAY_PHOTO_ENDPOINT=
