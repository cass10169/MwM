{
  "name": "memories-with-mike",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "vite",
    "build": "node scripts/build-verified.mjs",
    "deploy": "npm run build && wrangler deploy",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs tests/outdoor-rendered.test.mjs tests/commercial-rendered.test.mjs tests/tales-rendered.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "audit": "npm audit --omit=dev",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern playwright-report --ignore-pattern test-results --ignore-pattern legacy-2022",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "cloudflare:configure": "node scripts/configure-cloudflare.mjs",
    "cloudflare:whoami": "wrangler whoami",
    "db:migrate:local": "wrangler d1 migrations apply memories-with-mike --local",
    "db:migrate:remote": "wrangler d1 migrations apply memories-with-mike --remote",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jose": "6.1.3",
    "next": "16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "20.0.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "4.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Memories with Mike"
}
